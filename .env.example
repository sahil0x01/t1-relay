DATABASE_URL=postgres://relay:relay@localhost:5432/relay
TEST_DATABASE_URL=postgres://relay:relay@localhost:5432/relay_test

# From the GitHub App settings page (development app)
GITHUB_APP_ID=replace-me
GITHUB_APP_CLIENT_ID=replace-me
GITHUB_APP_CLIENT_SECRET=replace-me
# base64 of the downloaded .pem, on one line: base64 -i key.pem | tr -d '\n'
GITHUB_APP_PRIVATE_KEY=replace-me
# Must match the webhook secret in the GitHub App settings
GITHUB_WEBHOOK_SECRET=replace-me
